{
  "name": "dsh-any-preview",
  "version": "0.1.0-test.2",
  "description": "General-purpose file preview renderers for the DeepSeek Harness right Sidebar",
  "type": "module",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actcwlf/dsh-any-preview.git"
  },
  "homepage": "https://github.com/actcwlf/dsh-any-preview#readme",
  "bugs": {
    "url": "https://github.com/actcwlf/dsh-any-preview/issues"
  },
  "main": "lib/index.js",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=11"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/three-chunk.js",
    "lib/model-extras-chunk.js",
    "lib/mux-chunk.js",
    "lib/lzma.wasm",
    "lib/draco_wasm_wrapper.js",
    "lib/draco_decoder.wasm",
    "lib/basis_transcoder.js",
    "lib/basis_transcoder.wasm",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "LICENSE",
    "licenses"
  ],
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:decoders": "node scripts/sync-decoders.mjs",
    "build": "tsdown && node scripts/sync-decoders.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-isolation=none \"test/*.test.mjs\""
  },
  "devDependencies": {
    "mux.js": "^7.1.0",
    "sharp": "^0.35.5",
    "three": "^0.180.0",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3"
  }
}
